# Copy to .env (never commit real secrets) and let Docker Compose read it.

# Public origin the browser uses. Must be HTTPS for collaboration and must match
# exactly (no trailing slash).
APP_ORIGIN=https://boards.example.com

# Image tag to deploy. `latest` follows every GHCR publish; pin `sha-<short>`
# (from the Actions run) for an immutable deploy.
IMAGE_TAG=latest

# Postgres
POSTGRES_DB=excalidraw
POSTGRES_USER=excalidraw
POSTGRES_PASSWORD=change-me

# 32+ random bytes. e.g. `openssl rand -base64 48`
SESSION_SECRET=change-me

# First account, created automatically on API boot.
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=change-me

# SMTP for magic links and invite emails. Leave empty to log links to API stdout.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false

# OAuth (optional). Register these callbacks:
#   https://<domain>/api/auth/oauth/google/callback
#   https://<domain>/api/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Limits
MAX_SCENE_BYTES=16777216
MAX_FILE_BYTES=8388608
